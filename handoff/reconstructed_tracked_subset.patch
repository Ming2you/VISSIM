+        for lane in lanes:
+            requests[(spec['incoming_movements'][movement],str(lane))][movement]=intended[movement]/len(lanes)
+    ledger=get_ledger(state)
+    for (connector,lane),sources in requests.items():
+        total=sum(sources.values())
