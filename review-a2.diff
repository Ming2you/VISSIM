+    with args.ownership.open(encoding="utf-8") as handle:
+        ownership = json.load(handle)
+    with args.adjacency.open(encoding="utf-8") as handle:
+        adjacency = json.load(handle)
+    with args.capacity.open(encoding="utf-8") as handle:
