  "outputs/boundary_input_alignment_pedfold_20260814.json": "66f55d139ac2c8770fa76688fc9ed1cb69d3968ef2a2e3c479251aa048b1d722",
  "evaluation/real_world_modi_control_distributed_20260728/control_mapping_distributed_core17legs4b_20260819.json": "c74257c84ce2926ee889130a99a8dbafb95bc498ae3d434a31072f40b143a48c"
 },
 "decision_log": [
  {
   "id": "freeway-onramp",
   "what": "on-ramp 미터 커넥터 8개를 freeway 권역으로",
   "detail": "FW_E <- 10484·10490·10639·10681, FW_W <- 10480·10482·10644·10646",
   "evidence": "전부 ramp_meter 이고 to_model_link 과 100% 일치. 신호두는 SC9101~9108(램프미터 신호기)."
  },
  {
   "id": "link-78",
   "what": "link 78 을 FW_E·FW_W 양쪽에",
   "evidence": "link 31 의 static route decision 이 destLink 24(FW_E)·26(FW_W) 양쪽으로 보낸다. 78 -10703-> 31 -10484-> 24 / -10480-> 26."
  },
  {
   "id": "ramp-roadway-orphan",
   "what": "램프 차도 31·68 과 off-ramp 커넥터 10479·10483·10645·10682 는 고아로 둔다",
   "evidence": "사용자 판정 — 초입부만 freeway 이고 그 뒤는 sink 라 바로 termination 된다."
  },
  {
   "id": "sc1-east",
   "what": "SC1 의 East 5개를 North 에서 제거",
   "detail": "1210008202·254·1220008202·1220008203·1210008203",
   "evidence": "폴백이 만든 중복. territory 원본에는 E 에만 있었다."
  },
  {
   "id": "sc1-n-sc11",
   "what": "SC1·N_SC11 leg 삭제",
   "evidence": "신호군 지도 SC11_to_SC1 = WBT -> 접근 E. 인접표가 N 으로 붙인 것이 오배정이고 E 가 이미 그 도로(236·240·242·251 …)를 갖는다."
  },
  {
   "id": "sc11-s",
   "what": "SC11·S_SC1 -> S_SC7 이름 변경(11개)",
   "evidence": "SC1_to_SC11 = EBT -> W(이미 W 가 갖는다), SC7_to_SC11 = NBT -> S. S 의 내용은 SC7 것이다."
  },
  {
   "id": "sc5",
   "what": "SC5 에 N <- 1210019201, W <- 1210014303, S <- 1220011101·10116·1220011103",
   "evidence": "1210019201 은 SC102 의 블록2 신호(본교차로에서 132 m). 나머지는 무소유였다."
  },
  {
   "id": "sc11-n",
   "what": "SC11·N <- 1220014000"
  },
  {
   "id": "sc101-e",
   "what": "SC101·E <- 1220014203",
   "evidence": "SC5 의 블록2 신호(본교차로에서 222 m)."
  },
  {
   "id": "sc103-e",
   "what": "SC103 에 E leg 신설 + 링크 12개",
   "detail": "1220024201·10154·10155·105·10156·10157·106·10162·110·10160·10161·111"
  },
  {
   "id": "sc2001-s",
   "what": "SC2001 에 S leg 신설 + link 79",
   "evidence": "79 의 신호군이 S 라고 한다(일치)."
  },
  {
   "id": "link-21",
   "what": "link 21 을 SC108 -> SC109·W_SC108 로",
   "evidence": "21 은 상류가 없는 진입 링크이고 하류가 2홉 뒤 173(SC109). 신호두가 SC108 인 건 컨트롤러 소속일 뿐 실제 정지선은 SC109 다. 자동 규칙의 대표 반례."
  },
  {
   "id": "sc107-direct",
   "what": "SC107 의 W 는 자기 직결분만 — 공용 간선 56·75·69 와 남의 링크에서 들어오는 커넥터 10570·10621·10624·10627·10632·10634 제거(11개)",
   "evidence": "정지선에서 나가는 커넥터 10023·10616·10622 는 상류가 SC107 자기 정지선이라 남긴다."
  },
  {
   "id": "underpass",
   "what": "지상/지하차도 분리",
   "detail": "SC107 W_SC1004 -> W_SC1005(지하 61·387), W_SC1004 <- 10621(지상 우회). SC1004 E_SC1005(지상 13) / E_SC107 <- 10501(지하 1). SC1005 W <- 75·10701(지하 진입).",
   "evidence": "경로가 둘이다. 지하 69->75(2차로)->56->57(2차로)->61(2차로)->387->1220000201, 지상 56->10621->387. 10501 <- 1220000102 <- 183(SC107 정지선)이라 SC107 경로, 10498 <- 58 <- 62(SC1005 정지선)이라 SC1005 경로."
  },
  {
   "id": "config-regen-20260819",
   "what": "config_todo 4건 반영 후 재생성 — core17legs4b_20260819",
   "detail": "leg 삭제 SC1·N_SC11 · SC11·S_SC1 / 신설 SC103·E · SC2001·S. 인접표 방위 정정은 core17legs4b 인접표에 기록했다.",
   "evidence": "재생성 결과 movement 474, 가능한 회전 474, 비율 1.00. 정방위 아닌 leg 0. SC1·E_SC11 과 SC11·W_SC1 은 기존 게이트와 같은 방위로 병합되어 접근로를 공유한다."
  },
  {
   "id": "sc1004-west-split-20260819",
   "what": "link 69 를 권역에서 빼고, 분기 이후부터 소유하게 나눴다 (사용자 지시)",
   "detail": "69 는 신호두 없는 서측 진입점(1400 veh/h)이고 분기 전 공용 줄기다. static route 로 966(69%)이 램프미터 10644 를 타고 freeway 로 빠지고, 193 이 지하차도 10636→75(SC1005), 193+48 이 10637→70 / 10640→71 로 SC1004 로 간다. 이걸 한 player 에 통째로 주면 그 게이트 도착량이 3배 넘게 부풀려진다. SC1004·W = 신호 정지선 71 과 그 앞뒤 커넥터. SC1004·W_RAMP = 램프 접속부 70 과 off-ramp 도착 10638(26에서)·10643(2에서). SC1005·W = 지하차도 분기 10636 부터. on-ramp 10644·10639 는 램프미터(RM_C10644 sc9104 · RM_C10639 sc9105)라 freeway 권역 유지. [2026-08-19 사용자 정정] 10641·10700(70->71)은 램프 접속부에서 나오는 합류라 W_RAMP 로. SC1004·W 는 71·10640 과 정지선 진출(10634·10635·10642).",
   "evidence": "71 에만 SC1004 신호두(sg 2·5)가 있다 — 신호로 조이는 자리는 71 이지 69 가 아니다. 70 은 26·2 에서 off-ramp 가 도착하고 10639 로 on-ramp 가 떠나는 램프 접속부다. control_mapping ramp_meters 가 10644·10639 를 못 박는다."
  }
 ],
