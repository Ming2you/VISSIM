# bulky per-decision raw payloads (state/action json per control step) - local only
**/decisions/
**/decisions_*/
evaluation/runs/*/replay_*/
evaluation/runs/8seg_pulse_syntax_smoke/
evaluation/runs/

# vissim scratch / caches
__pycache__/
*.pyc
tmp_probe_*
*.results/
evaluation/tmp_probe_des_speed.*
network/**/vissim_eval/
network/**/vissim_eval_probe/
network/**/*.db
network/**/*.att
network/**/*.knr
network/**/*.rsr

# aborted-run leftovers
evaluation/runs/8seg_sweet190_ab_20260714/
evaluation/runs/8seg_sweet190_ab_180s_20260714/
*.err
runlog_*.txt.err

# vissim auto-save / manual backups (bulky binaries, not source)
*.inp0
*.bak_*

# v3 N0 - 실 네트워크에서 결정적으로 재생성되는 대형 토폴로지 산출물 (합계 42 MB).
# 산출물이 아니라 SHA-256 이 정본이며 context-notes.md 에 기록한다.
# 재생성 명령은 IMPLEMENTATION_PLAN_V3_LEAN.md 의 N0 절에 있다.
outputs/lane_route_graph_v2_1.json
outputs/lane_route_proofs_v2_1.json
outputs/physical_stock_topology_v2_1.json
# 2026-08-14: 격자 판본마다 같은 셋이 생긴다(그래프 2.5 + 증명 8.5 + 토폴로지 ~30 MB).
# v2_1 과 같은 이유로 커밋하지 않는다 - 입력에서 결정적으로 재생성되고 해시가 정본이다.
outputs/lane_route_graph_*.json
outputs/lane_route_proofs_*.json
outputs/physical_stock_topology_*.json
# canonical Phase-0 토폴로지(24 MB). 실런 네트워크에서 9초면 재생성된다.
#   python scripts/build_canonical_topology.py
# 낡았는지는 --check-only 로 본다. 저장해 두면 낡는다 - 07-31 사본이 소스 네트워크와
# 컴파일러 판번호 둘 다 낡은 채로 신호를 37/392/475 로 과소 계상했다(실제 50/440/541).
outputs/canonical_topology_v3.json
# 2026-08-14: 망 판본마다 정본 토폴로지가 하나씩 생긴다(판당 23 MB). v3 초판과 같은
# 이유로 커밋하지 않는다 - build_canonical_topology.py 로 재생성되고 산출물이 자기
# provenance 에 inpx_sha256 을 싣고 있어 어느 망에서 나왔는지 추적 가능하다.
outputs/canonical_topology_*.json
plant/outputs/canonical_topology_*.json
# topology_approval_v2_1.json 은 무시하지 않는다. v3 초판이 승인 사슬을 뺀 것은 오판이었고
# N0-3 에서 되살렸다 - validate_state_projection_v2_1.py:22-26 이 그것을 import 한다.

# 격리 보관 폴더. outputs/canonical_topology_*.json 패턴은 * 가 슬래시를 넘지 않아
# 하위 폴더로 옮기는 순간 무시가 풀린다 (24MB x 5 = 121MB 가 git status 에 뜬다).
outputs/_superseded_*/**/canonical_topology_*.json
outputs/_superseded_*/canonical_topology_*.json

# 아카이브 보관 폴더. outputs/canonical_topology_*.json 같은 패턴은 * 가 슬래시를
# 넘지 않아 하위로 옮기면 무시가 풀린다. 24MB 짜리가 여럿이라 반드시 필요하다.
_archive/**/canonical_topology_*.json
_archive/**/lane_route_graph_*.json
_archive/**/lane_route_proofs_*.json
_archive/**/physical_stock_topology_*.json
