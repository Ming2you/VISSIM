    },
    "phase_1_after_signal_objects": {
      "mode": "fixed_time",
      "cycle_sec": 90,
      "offset_sec": 0,
      "intersections": {
        "A": {"major_axis_green_sec": 45, "minor_axis_green_sec": 35, "clearance_sec": 10},
        "B": {"major_axis_green_sec": 45, "minor_axis_green_sec": 35, "clearance_sec": 10},
        "C": {"major_axis_green_sec": 45, "minor_axis_green_sec": 35, "clearance_sec": 10},
        "D": {"major_axis_green_sec": 40, "minor_axis_green_sec": 40, "clearance_sec": 10},
        "F": {"major_axis_green_sec": 40, "minor_axis_green_sec": 40, "clearance_sec": 10}
