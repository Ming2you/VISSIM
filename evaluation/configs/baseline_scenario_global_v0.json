{
  "schema_version": 1,
  "name": "baseline_scenario_global_v0",
  "purpose": "First evaluation baseline for the hypothetical Vissim network using global state. This is intentionally detector-independent.",
  "network": {
    "inpx_source": "C:\\Users\\TRLAB\\Desktop\\찐찐막\\Network_Vissim_Work\\modi.inpx",
    "layx_source": "C:\\Users\\TRLAB\\Desktop\\찐찐막\\Network_Vissim_Work\\modi.layx",
    "mapping": "evaluation/current_inventory/network_mapping.json",
    "geometry_policy": "freeze_current_user_edited_geometry"
