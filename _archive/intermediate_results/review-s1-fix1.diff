+            "physical_invariant": False,
+            "equal_raw_ms_timeline_pairs": [[2, 5], [1, 6]],
+            "program_nos": [1, 2, 3],
+        },
+        "summary": {
+            "pass": counts[STATUS_PASS],
+            "fail": counts[STATUS_FAIL],
+            "not_evaluated": counts[STATUS_NOT_EVALUATED],
+        },
+        "checks": checks,
+    }
