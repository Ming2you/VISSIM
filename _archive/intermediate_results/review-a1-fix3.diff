+def _network_objects(manifest: dict[str, Any]) -> Iterable[tuple[str, dict[str, Any]]]:
+    for link in manifest.get("links", []):
+        yield "link", link
+    for connector in manifest.get("connectors", []):
+        yield "connector", connector
