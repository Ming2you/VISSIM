+        "schema_version": artifact["schema_version"],
+        "links": artifact["links"],
+        "nodes": artifact["nodes"],
+        "edges": artifact["edges"],
+        "connectors": artifact["connectors"],
+        "signal_heads": artifact["signal_heads"],
+    }
