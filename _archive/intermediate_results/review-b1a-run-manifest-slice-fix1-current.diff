+
+def state_set_semantic_payload(states: Sequence[Mapping[str, Any]]) -> list[dict[str, Any]]:
+    fields = (
+        "state_path",
+        "state_file_sha256",
+        "run_id",
+        "sim_sec",
+        "run_manifest_path",
