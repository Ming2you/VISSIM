+def _read_runlog(path: Path) -> tuple[str, str | None]:
+    if not path.is_file():
+        return "", "run log is missing"
+    try:
+        return path.read_text(encoding="utf-8-sig", errors="replace"), None
+    except OSError as exc:
+        return "", str(exc)
+
