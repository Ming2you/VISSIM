+def _summary_value(text: str, key: str) -> tuple[str | None, str | None]:
+    values = re.findall(rf"(?m)^{re.escape(key)}=([^\r\n]+)\s*$", text)
+    if len(values) != 1:
+        return None, f"expected one {key} line, found {len(values)}"
+    return values[0].strip(), None
