+    ReDim pieces(Len(text) - 1)
+    For i = 1 To Len(text)
+        ch = Mid(text, i, 1)
+        code = AscW(ch)
+        Select Case code
+            Case 8
+                pieces(i - 1) = "\b"
+            Case 9
+                pieces(i - 1) = "\t"
+            Case 10
+                pieces(i - 1) = "\n"
+            Case 12
+                pieces(i - 1) = "\f"
+            Case 13
+                pieces(i - 1) = "\r"
+            Case 34
+                pieces(i - 1) = "\" & Chr(34)
+            Case 92
+                pieces(i - 1) = "\\"
+            Case Else
+                If code >= 0 And code <= 31 Then
+                    pieces(i - 1) = "\u" & Right("0000" & Hex(code), 4)
+                Else
+                    pieces(i - 1) = ch
+                End If
+        End Select
+    Next
+    JsonEscape = Join(pieces, "")
