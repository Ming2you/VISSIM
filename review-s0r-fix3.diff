+        "command_version",
+        "reasons",
+        "sample_dimensions",
+        "units",
+        "downstream_consumers",
+        "policy",
+        "inputs",
+        "network",
+        "link_assignment",
+        "adjacency",
+        "storage_capacity",
+        "vendor_snapshot",
+        "actual_numsim",
+        "state_observations",
+        "action_directory",
+        "vissim_error",
+        "artifact_evidence",
+        "gates",
+        "gate_summary",
+        "completion_policy",
+        "strict",
+        "require_complete",
+        "status",
+        "invocation",
+    )
+    return {field: manifest.get(field) for field in fields}
