+def _force_open_ramps(control, cfg) -> None:
+    cap = getattr(cfg.network, "ramp_capacity_veh_h", {}) or {}
+    ramps = list(getattr(cfg.network, "ramps", ()) or cap.keys())
+    control.ramp_metering = {
+        str(ramp): float(cap.get(str(ramp), 1800.0))
+        for ramp in ramps
+    }
