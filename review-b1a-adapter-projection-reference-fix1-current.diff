+            "lane_interval_overlaps",
+            "lane_interval_missing_lanes",
+            "lane_interval_nonpositive",
+            "duplicate_stock_ids",
+            "legacy_partition_duplicate",
+            "legacy_partition_missing_from_a1",
+            "legacy_partition_identity_mismatch",
+            "objective_policy_violations",
