+            continue
+        expected_fields = {
+            "from_link_no": source["link_no"],
+            "from_lane_no": source["lane_no"],
+            "to_link_no": target["link_no"],
+            "to_lane_no": target["lane_no"],
+        }
+        if any(edge.get(field) != value for field, value in expected_fields.items()):
