+def _workspace_path(path_text: str, default: Path | None = None) -> Path:
+    if not path_text:
+        return default if default is not None else WORKSPACE_ROOT
+    path = Path(path_text)
+    if path.is_absolute():
+        return path
+    return WORKSPACE_ROOT / path
