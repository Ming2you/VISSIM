+            "stock_edges": len(edges),
+            "route_memberships": route_membership_count,
+            "stocks_by_parent_kind": dict(sorted(parent_kind_counts.items())),
+            "stocks_by_role": dict(sorted(role_counts.items())),
+            "objective_weight_one_counts": {
