+def vissim_error_directory_evidence(root: Path | None) -> dict[str, Any]:
+    root_exists = root is not None and root.is_dir()
+    provenance_by_name: dict[str, tuple[str, Path, Mapping[str, Any]]] = {}
+    if root_exists:
