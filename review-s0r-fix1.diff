+            payload, error = load_json(provenance_path)
+            if error or not isinstance(payload, Mapping):
+                continue
+            name = str(payload.get("name", "")).strip()
+            if name:
+                provenance_by_name[name] = (str(payload.get("run_id", "")).strip(), provenance_path, payload)
+
